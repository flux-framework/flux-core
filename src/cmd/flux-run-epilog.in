#
# Run the job epilog in the flux-epilog@ systemd unit.
#
# Executed as root by flux-imp run. The interpreter runs in isolated mode
# (-I) so that no PYTHON* environment variable or user site directory can
# affect it, and the flux package is located via its installed path.

import sys

# The flux package may be installed outside this interpreter's default
# module path. As in src/cmd/py-runner.py, prepend the installed link
# directory (the python_path builtin), which contains only the flux and
# _flux packages, so that this build's package is used. Unlike py-runner,
# the path is fixed at build time and FLUX_PYTHONPATH_PREPEND is not
# honored, since nothing in the environment should influence what runs here.
sys.path.insert(0, "@X_FLUXPYLINKDIR@")

import flux.perilog  # noqa: E402

sys.exit(flux.perilog.main("epilog", "@X_RUNSTATEDIR@"))
