#!/bin/bash
#
# Format python with black, and C with clang-format (via clang-format-flux).
#
# C formatting applies only to lines changed relative to the merge-base with
# master, so new and modified code follows RFC 7 without reformatting older
# code that nobody is touching.  Use --all to reformat every C file.
#
if command -v black 2>&1 > /dev/null ; then
    # awk cmd copied from:
    # https://unix.stackexchange.com/questions/66097/find-all-files-with-a-python-shebang
    find src t \
        -path "src/bindings/python/_flux" -prune -o \
        -path "src/bindings/python/flux/utils" -prune -o \
        -type f \( -name "*.py" -print -o \
        -exec awk ' /^#!.*python/{print FILENAME} {nextfile}' {} + \) \
        | xargs black
else
  echo "black not found, python left unformatted"
fi

if command -v clang-format 2>&1 > /dev/null ; then
    if [[ $1 == "--all" ]]; then
        # clang-format-flux skips vendored/copied code itself.
        git ls-files 'src/*.c' 'src/*.h' | xargs scripts/clang-format-flux
    else
        scripts/clang-format-flux --base ${FORMAT_BASE:-auto}
    fi
else
  echo "clang-format not found, C left unformatted (pip install -r scripts/requirements-dev.txt)"
fi
